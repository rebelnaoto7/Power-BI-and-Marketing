{
 "compatibilityLevel": 1600,
 "model": {
  "culture": "ja-JP",
  "defaultPowerBIDataSourceVersion": "powerBI_V3",
  "sourceQueryCulture": "ja-JP",
  "dataAccessOptions": {
   "legacyRedirects": true,
   "returnErrorValuesAsNull": true
  },
  "tables": [
   {
    "name": "Dim_Date",
    "columns": [
     {
      "name": "日付",
      "dataType": "dateTime",
      "sourceColumn": "日付",
      "summarizeBy": "none",
      "formatString": "yyyy/mm/dd",
      "isKey": true
     },
     {
      "name": "年",
      "dataType": "int64",
      "sourceColumn": "年",
      "summarizeBy": "none"
     },
     {
      "name": "四半期",
      "dataType": "string",
      "sourceColumn": "四半期",
      "summarizeBy": "none"
     },
     {
      "name": "月",
      "dataType": "int64",
      "sourceColumn": "月",
      "summarizeBy": "none"
     },
     {
      "name": "月名",
      "dataType": "string",
      "sourceColumn": "月名",
      "summarizeBy": "none",
      "sortByColumn": "月"
     },
     {
      "name": "年月",
      "dataType": "string",
      "sourceColumn": "年月",
      "summarizeBy": "none",
      "sortByColumn": "年月番号"
     },
     {
      "name": "年月番号",
      "dataType": "int64",
      "sourceColumn": "年月番号",
      "summarizeBy": "none"
     },
     {
      "name": "曜日",
      "dataType": "string",
      "sourceColumn": "曜日",
      "summarizeBy": "none",
      "sortByColumn": "曜日番号"
     },
     {
      "name": "曜日番号",
      "dataType": "int64",
      "sourceColumn": "曜日番号",
      "summarizeBy": "none"
     },
     {
      "name": "平日休日",
      "dataType": "string",
      "sourceColumn": "平日休日",
      "summarizeBy": "none"
     },
     {
      "type": "calculated",
      "name": "実績あり",
      "dataType": "boolean",
      "expression": "Dim_Date[日付] <= MAX ( Fact_Orders[注文日] )",
      "summarizeBy": "none"
     }
    ],
    "partitions": [
     {
      "name": "Dim_Date",
      "mode": "import",
      "source": {
       "type": "m",
       "expression": [
        "let",
        "    ソース = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"日付\" = _t, #\"年\" = _t, #\"四半期\" = _t, #\"月\" = _t, #\"月名\" = _t, #\"年月\" = _t, #\"年月番号\" = _t, #\"曜日\" = _t, #\"曜日番号\" = _t, #\"平日休日\" = _t]),",
        "    変更された型 = Table.TransformColumnTypes(ソース, {{\"日付\", type date}, {\"年\", Int64.Type}, {\"四半期\", type text}, {\"月\", Int64.Type}, {\"月名\", type text}, {\"年月\", type text}, {\"年月番号\", Int64.Type}, {\"曜日\", type text}, {\"曜日番号\", Int64.Type}, {\"平日休日\", type text}})",
        "in",
        "    変更された型"
       ]
      }
     }
    ],
    "dataCategory": "Time"
   },
