     },
     {
      "name": "顧客ID",
      "dataType": "string",
      "sourceColumn": "顧客ID",
      "summarizeBy": "none"
     },
     {
      "name": "商品ID",
      "dataType": "string",
      "sourceColumn": "商品ID",
      "summarizeBy": "none"
     },
     {
      "name": "チャネルID",
      "dataType": "string",
      "sourceColumn": "チャネルID",
      "summarizeBy": "none"
     },
     {
      "name": "キャンペーンID",
      "dataType": "string",
      "sourceColumn": "キャンペーンID",
      "summarizeBy": "none"
     },
     {
      "name": "数量",
      "dataType": "int64",
      "sourceColumn": "数量",
      "summarizeBy": "sum"
     },
     {
      "name": "単価",
      "dataType": "int64",
      "sourceColumn": "単価",
      "summarizeBy": "sum"
     },
     {
      "name": "売上金額",
      "dataType": "int64",
      "sourceColumn": "売上金額",
      "summarizeBy": "sum"
     },
     {
      "type": "calculated",
      "name": "新規リピート",
      "dataType": "string",
      "expression": "IF ( Fact_Orders[注文日] = RELATED ( Dim_Customer[初回購入日] ), \"新規\", \"リピート\" )",
      "summarizeBy": "none"
     }
    ],
    "partitions": [
     {
      "name": "Fact_Orders",
      "mode": "import",
      "source": {
       "type": "m",
       "expression": [
        "let",
        "    ソース = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"注文ID\" = _t, #\"注文日\" = _t, #\"顧客ID\" = _t, #\"商品ID\" = _t, #\"チャネルID\" = _t, #\"キャンペーンID\" = _t, #\"数量\" = _t, #\"単価\" = _t, #\"売上金額\" = _t]),",
        "    変更された型 = Table.TransformColumnTypes(ソース, {{\"注文ID\", type text}, {\"注文日\", type date}, {\"顧客ID\", type text}, {\"商品ID\", type text}, {\"チャネルID\", type text}, {\"キャンペーンID\", type text}, {\"数量\", Int64.Type}, {\"単価\", Int64.Type}, {\"売上金額\", Int64.Type}})",
        "in",
        "    変更された型"
       ]
      }
     }
    ]
   },
