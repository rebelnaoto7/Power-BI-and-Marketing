        "    変更された型 = Table.TransformColumnTypes(ソース, {{\"顧客ID\", type text}, {\"初回購入日\", type date}, {\"獲得チャネル\", type text}, {\"年代\", type text}, {\"都道府県\", type text}, {\"地域\", type text}})",
