     },
     {
      "type": "calculated",
      "name": "初回購入年",
      "dataType": "int64",
      "expression": "YEAR ( Dim_Customer[初回購入日] )",
      "summarizeBy": "none"
     }
    ],
    "partitions": [
     {
      "name": "Dim_Customer",
