   },
   {
    "name": "許容CPA",
    "columns": [
     {
      "type": "calculatedTableColumn",
      "name": "許容CPA",
      "dataType": "int64",
      "sourceColumn": "[Value]",
      "isNameInferred": false,
      "isDataTypeInferred": true,
      "summarizeBy": "none"
     }
    ],
    "partitions": [
     {
      "name": "許容CPA",
      "mode": "import",
      "source": {
       "type": "calculated",
       "expression": "GENERATESERIES ( 1000, 10000, 500 )"
      }
     }
    ],
    "measures": [
     {
      "name": "許容CPA 値",
      "expression": "SELECTEDVALUE ( '許容CPA'[許容CPA], 4000 )"
     }
    ],
    "extendedProperties": [
     {
      "type": "json",
      "name": "ParameterMetadata",
      "value": {
       "version": 0
      }
     }
    ]
   },
   {
    "name": "_メジャー",
    "columns": [
     {
      "name": "列1",
      "dataType": "string",
      "sourceColumn": "列1",
      "isHidden": true,
      "summarizeBy": "none"
     }
    ],
    "partitions": [
     {
      "name": "_メジャー",
      "mode": "import",
      "source": {
       "type": "m",
       "expression": [
        "let",
        "    ソース = #table(type table [列1 = text], {})",
        "in",
        "    ソース"
       ]
      }
     }
    ],
    "measures": [
     {
      "name": "売上",
      "expression": [
       "SUM ( Fact_Orders[売上金額] )"
      ],
      "displayFolder": "1 基本",
      "formatString": "#,0",
      "description": "注文明細の売上金額を合計する。いちばん最初に作るメジャー。"
     },
     {
      "name": "注文数",
      "expression": [
       "DISTINCTCOUNT ( Fact_Orders[注文ID] )"
      ],
      "displayFolder": "1 基本",
      "formatString": "#,0",
      "description": "注文IDの“種類の数”を数える。1つの注文に商品が2つあると明細は2行になるので、行数（COUNTROWS）ではなく DISTINCTCOUNT を使う。"
     },
     {
      "name": "平均注文単価",
      "expression": [
       "DIVIDE ( [売上], [注文数] )"
      ],
      "displayFolder": "1 基本",
      "formatString": "#,0",
      "description": "1回の注文あたりの金額（AOV）。割り算は「/」ではなく DIVIDE を使うと、0で割ってもエラーにならない。"
     },
     {
      "name": "購入者数",
      "expression": [
       "DISTINCTCOUNT ( Fact_Orders[顧客ID] )"
      ],
      "displayFolder": "1 基本",
      "formatString": "#,0",
      "description": "期間中に1回以上買った人の数（同じ人が何回買っても1人）。"
     },
     {
      "name": "販売数量",
      "expression": [
       "SUM ( Fact_Orders[数量] )"
      ],
      "displayFolder": "1 基本",
      "formatString": "#,0",
      "description": "売れた商品の個数の合計。"
     },
     {
      "name": "広告費",
      "expression": [
       "SUM ( Fact_Ads[広告費] )"
      ],
      "displayFolder": "2 広告",
      "formatString": "#,0",
      "description": "広告に使ったお金の合計。"
     },
     {
      "name": "表示回数",
      "expression": [
       "SUM ( Fact_Ads[表示回数] )"
      ],
      "displayFolder": "2 広告",
      "formatString": "#,0",
      "description": "広告が表示された回数（インプレッション）。"
     },
     {
      "name": "クリック数",
      "expression": [
       "SUM ( Fact_Ads[クリック数] )"
      ],
      "displayFolder": "2 広告",
      "formatString": "#,0",
      "description": "広告がクリックされた回数。"
     },
     {
      "name": "CTR",
      "expression": [
       "DIVIDE ( [クリック数], [表示回数] )"
      ],
      "displayFolder": "2 広告",
      "formatString": "0.00%",
      "description": "クリック率。表示されたうち何%がクリックされたか。広告の“つかみ”（画像・文章）の良さを表す。"
     },
     {
      "name": "CPC",
      "expression": [
       "DIVIDE ( [広告費], [クリック数] )"
      ],
      "displayFolder": "2 広告",
      "formatString": "#,0.0",
      "description": "1クリックあたりの広告費。"
     },
     {
      "name": "広告経由の注文数",
      "expression": [
       "CALCULATE ( [注文数], Dim_Channel[有料広告] = \"はい\" )"
      ],
      "displayFolder": "2 広告",
      "formatString": "#,0",
      "description": "CALCULATE で「有料広告のチャネルだけ」に絞った注文数。広告費と同じ範囲（広告）どうしで割るために使う。"
     },
     {
      "name": "広告経由の売上",
      "expression": [
       "CALCULATE ( [売上], Dim_Channel[有料広告] = \"はい\" )"
      ],
      "displayFolder": "2 広告",
      "formatString": "#,0",
      "description": "有料広告のチャネルから生まれた売上（最後にクリックした広告で数える「ラストクリック」の考え方）。"
     },
     {
      "name": "CPA",
      "expression": [
       "DIVIDE ( [広告費], [広告経由の注文数] )"
      ],
      "displayFolder": "2 広告",
      "formatString": "#,0",
      "description": "1件の注文を取るのにかかった広告費（獲得単価）。低いほど効率がよい。"
     },
     {
      "name": "ROAS",
      "expression": [
       "DIVIDE ( [広告経由の売上], [広告費] )"
      ],
      "displayFolder": "2 広告",
      "formatString": "0%",
      "description": "広告費1円あたり、いくらの売上になったか。300%なら「1円の広告で3円の売上」。100%未満は売上より広告費のほうが多い状態。"
     },
     {
      "name": "セッション数",
      "expression": [
       "SUM ( Fact_Web[セッション数] )"
      ],
      "displayFolder": "3 サイト・ファネル",
      "formatString": "#,0",
      "description": "サイトへの訪問の回数。"
     },
     {
      "name": "商品閲覧数",
      "expression": [
       "SUM ( Fact_Web[商品閲覧数] )"
      ],
      "displayFolder": "3 サイト・ファネル",
      "formatString": "#,0",
      "description": "商品ページを見た訪問の数。"
     },
     {
      "name": "カート投入数",
      "expression": [
       "SUM ( Fact_Web[カート投入数] )"
      ],
      "displayFolder": "3 サイト・ファネル",
      "formatString": "#,0",
      "description": "カートに商品を入れた訪問の数。"
     },
     {
      "name": "購入数",
      "expression": [
       "SUM ( Fact_Web[購入数] )"
      ],
      "displayFolder": "3 サイト・ファネル",
      "formatString": "#,0",
      "description": "購入まで進んだ訪問の数（＝注文数と同じになるように作ってあります）。"
     },
     {
      "name": "CVR",
      "expression": [
       "DIVIDE ( [購入数], [セッション数] )"
      ],
      "displayFolder": "3 サイト・ファネル",
      "formatString": "0.00%",
      "description": "コンバージョン率。訪問のうち何%が購入したか。分子も分母も同じ Fact_Web から取るのがポイント。"
     },
     {
      "name": "商品閲覧率",
      "expression": [
       "DIVIDE ( [商品閲覧数], [セッション数] )"
      ],
      "displayFolder": "3 サイト・ファネル",
      "formatString": "0.0%",
      "description": "訪問のうち、商品ページまで進んだ割合。"
     },
     {
      "name": "カート投入率",
      "expression": [
       "DIVIDE ( [カート投入数], [商品閲覧数] )"
      ],
      "displayFolder": "3 サイト・ファネル",
      "formatString": "0.0%",
      "description": "商品ページを見た訪問のうち、カートに入れた割合。"
     },
     {
      "name": "購入完了率",
      "expression": [
       "DIVIDE ( [購入数], [カート投入数] )"
      ],
      "displayFolder": "3 サイト・ファネル",
      "formatString": "0.0%",
      "description": "カートに入れた訪問のうち、購入まで完了した割合。低いと「送料・決済・入力のしにくさ」で離脱している可能性。"
     },
     {
      "name": "新規顧客数",
      "expression": [
       "CALCULATE ( [購入者数], Fact_Orders[新規リピート] = \"新規\" )"
      ],
      "displayFolder": "4 顧客",
      "formatString": "#,0",
      "description": "期間中に“はじめて”買った人の数。計算列「新規リピート」で絞り込む。"
     },
     {
      "name": "リピート顧客数",
      "expression": [
       "CALCULATE ( [購入者数], Fact_Orders[新規リピート] = \"リピート\" )"
      ],
      "displayFolder": "4 顧客",
      "formatString": "#,0",
      "description": "期間中に2回目以降の購入をした人の数。"
     },
     {
      "name": "リピート売上比率",
      "expression": [
       "DIVIDE ( CALCULATE ( [売上], Fact_Orders[新規リピート] = \"リピート\" ), [売上] )"
      ],
      "displayFolder": "4 顧客",
      "formatString": "0.0%",
      "description": "売上のうち、リピート購入（2回目以降）が占める割合。"
     },
     {
      "name": "CAC",
      "expression": [
       "DIVIDE ( [広告費], [新規顧客数] )"
      ],
      "displayFolder": "4 顧客",
      "formatString": "#,0",
      "description": "新規顧客1人を獲得するのにかかった広告費（顧客獲得単価）。LTV と比べて判断する。"
     },
     {
      "name": "獲得顧客数",
      "expression": [
       "COUNTROWS ( Dim_Customer )"
      ],
      "displayFolder": "4 顧客",
      "formatString": "#,0",
      "description": "顧客テーブルの行数＝顧客の人数。「初回購入年」や「獲得チャネル」で絞って、獲得した人数を数える。"
     },
     {
      "name": "LTV",
      "expression": [
       "DIVIDE (",
       "    CALCULATE ( [売上], REMOVEFILTERS ( Dim_Date ) ),",
       "    [獲得顧客数]",
       ")"
      ],
      "displayFolder": "4 顧客",
      "formatString": "#,0",
      "description": "顧客1人あたりの累計売上（これまでに買ってくれた金額の平均）。REMOVEFILTERS で期間の絞り込みを外し、いつ買ったかに関係なく全部を足す。"
     },
     {
      "name": "リピート率",
      "expression": [
       "DIVIDE (",
       "    COUNTROWS (",
       "        FILTER (",
       "            Dim_Customer,",
       "            CALCULATE ( [注文数], REMOVEFILTERS ( Dim_Date ) ) >= 2",
       "        )",
       "    ),",
       "    [獲得顧客数]",
       ")"
      ],
      "displayFolder": "4 顧客",
      "formatString": "0.0%",
      "description": "獲得した顧客のうち、2回以上買ってくれた人の割合。FILTER で顧客を1人ずつ調べ、注文数が2以上の人を数える。"
     },
     {
      "name": "粗利",
      "expression": [
       "SUMX (",
       "    Fact_Orders,",
       "    Fact_Orders[売上金額] - Fact_Orders[数量] * RELATED ( Dim_Product[原価] )",
       ")"
      ],
      "displayFolder": "5 利益",
      "formatString": "#,0",
      "description": "売上から商品の原価を引いた“もうけ”。SUMX で明細を1行ずつ計算してから合計する（原価は商品テーブルから RELATED で取る）。"
     },
     {
      "name": "粗利率",
      "expression": [
       "DIVIDE ( [粗利], [売上] )"
      ],
      "displayFolder": "5 利益",
      "formatString": "0.0%",
      "description": "売上のうち粗利が占める割合。"
     },
     {
      "name": "POAS",
      "expression": [
       "DIVIDE (",
       "    CALCULATE ( [粗利], Dim_Channel[有料広告] = \"はい\" ),",
       "    [広告費]",
       ")"
      ],
      "displayFolder": "5 利益",
      "formatString": "0%",
      "description": "広告費1円あたりの粗利。100%を超えていれば、広告経由の粗利で広告費をまかなえている。ROAS より“もうけ”に近い指標。"
     },
     {
      "name": "売上 前年同期",
      "expression": [
       "CALCULATE ( [売上], SAMEPERIODLASTYEAR ( Dim_Date[日付] ) )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "#,0",
      "description": "1年前の同じ期間の売上。日付テーブル（Dim_Date）を「日付テーブルとしてマーク」しておくことが前提。"
     },
     {
      "name": "売上 前年比",
      "expression": [
       "DIVIDE ( [売上] - [売上 前年同期], [売上 前年同期] )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "+0.0%;-0.0%;0.0%",
      "description": "前年同期と比べて何%増えたか（減ったか）。"
     },
     {
      "name": "売上 累計",
      "expression": [
       "TOTALYTD ( [売上], Dim_Date[日付] )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "#,0",
      "description": "その年の1月1日からの累計（年初来、YTD）。"
     },
     {
      "name": "売上 前月比",
      "expression": [
       "VAR PrevSales =",
       "    CALCULATE ( [売上], DATEADD ( Dim_Date[日付], -1, MONTH ) )",
       "RETURN",
       "    DIVIDE ( [売上] - PrevSales, PrevSales )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "+0.0%;-0.0%;0.0%",
      "description": "前の月と比べた増減率。VAR（変数）で「前月の売上」にいったん名前（PrevSales）をつけると、式が読みやすくなる。変数名は半角の英数字だけ（日本語は使えない）。"
     },
     {
      "name": "売上 3か月移動平均",
      "expression": [
       "VAR Period3M =",
       "    DATESINPERIOD ( Dim_Date[日付], MAX ( Dim_Date[日付] ), -3, MONTH )",
       "RETURN",
       "    CALCULATE ( AVERAGEX ( VALUES ( Dim_Date[年月] ), [売上] ), Period3M )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "#,0",
      "description": "直近3か月の月売上の平均。月ごとのでこぼこをならして、流れ（トレンド）を見やすくする。"
     },
     {
      "name": "売上構成比",
      "expression": [
       "DIVIDE ( [売上], CALCULATE ( [売上], ALLSELECTED ( Dim_Channel ) ) )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "0.0%",
      "description": "表に表示しているチャネルの合計に対する割合。ALLSELECTED は「表の中の行の絞り込みだけを外す」。全チャネルに対する割合にしたいときは ALL を使う。"
     },
     {
      "name": "チャネル売上順位",
      "expression": [
       "RANKX ( ALLSELECTED ( Dim_Channel ), [売上] )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "0",
      "description": "売上の大きい順の順位。ALLSELECTED でテーブル全体を指定すると、チャネル名を並び順の列で並べ替えていても正しく動く。"
     },
     {
      "name": "売上目標",
      "expression": [
       "SUM ( Fact_Target[売上目標] )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "#,0",
      "description": "月ごとの売上目標の合計。"
     },
     {
      "name": "目標達成率",
      "expression": [
       "DIVIDE ( [売上], [売上目標] )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "0.0%",
      "description": "売上 ÷ 売上目標。レポート全体のフィルターで「実績あり = True」にしておくと、まだ来ていない月の目標が入らない。"
     },
     {
      "name": "広告費予算",
      "expression": [
       "SUM ( Fact_Target[広告費予算] )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "#,0",
      "description": "月ごとの広告費の予算。"
     },
     {
      "name": "予算消化率",
      "expression": [
       "DIVIDE ( [広告費], [広告費予算] )"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "0.0%",
      "description": "予算のうち、どれだけ使ったか。"
     },
     {
      "name": "売上 前年同期（途中の年も正しく）",
      "expression": [
       "CALCULATE (",
       "    [売上],",
       "    CALCULATETABLE (",
       "        SAMEPERIODLASTYEAR ( Dim_Date[日付] ),",
       "        Dim_Date[実績あり] = TRUE",
       "    )",
       ")"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "#,0",
      "description": "レポートのフィルターに頼らず、メジャーだけで「今年の実績がある期間」と同じ期間の前年を取る書き方。年の途中で前年比を出すときの落とし穴を防ぐ。"
     },
     {
      "name": "目標達成率（実績のある月まで）",
      "expression": [
       "DIVIDE (",
       "    [売上],",
       "    CALCULATE ( [売上目標], Dim_Date[実績あり] = TRUE )",
       ")"
      ],
      "displayFolder": "6 時系列・比較",
      "formatString": "0.0%",
      "description": "まだ実績のない月の目標を分母から外した達成率（メジャーだけで完結する書き方）。"
     },
     {
      "name": "選択中のチャネル",
      "expression": [
       "SELECTEDVALUE ( Dim_Channel[チャネル名], \"すべてのチャネル\" )"
      ],
      "displayFolder": "7 表示の工夫",
      "description": "スライサーで1つだけ選ばれていればその名前、そうでなければ「すべてのチャネル」を返す。タイトルに使う。"
     },
     {
      "name": "売上タイトル",
      "expression": [
       "VAR YoY = [売上 前年比]",
       "RETURN",
       "    \"売上 \" & FORMAT ( [売上], \"#,0\" ) & \" 円\"",
       "        & IF ( NOT ISBLANK ( YoY ), \"（前年比 \" & FORMAT ( YoY, \"+0.0%;-0.0%\" ) & \"）\" )"
      ],
      "displayFolder": "7 表示の工夫",
      "description": "グラフのタイトルを数字入りの文章にする（動的タイトル）。［書式］→［タイトル］→ fx ボタンでこのメジャーを指定する。"
     },
     {
      "name": "前年比の色",
      "expression": [
       "VAR YoY = [売上 前年比]",
       "RETURN",
       "    IF ( NOT ISBLANK ( YoY ), IF ( YoY >= 0, \"#16A34A\", \"#DC2626\" ) )"
      ],
      "displayFolder": "7 表示の工夫",
      "description": "前年比がプラスなら緑、マイナスなら赤の色コードを返す。条件付き書式の［フィールド値］で使う。"
     },
     {
      "name": "CPA判定",
      "expression": [
       "VAR CurrentCPA = [CPA]",
       "RETURN",
       "    IF ( NOT ISBLANK ( CurrentCPA ), IF ( CurrentCPA > [許容CPA 値], \"要改善\", \"OK\" ) )"
      ],
      "displayFolder": "7 表示の工夫",
      "description": "CPA が許容CPA（What-if パラメーターで動かせる上限）を超えていたら「要改善」。広告費がないチャネルは空白にする。"
     }
    ]
   }
  ],
  "relationships": [
   {
    "name": "r01",
    "fromTable": "Fact_Orders",
    "fromColumn": "注文日",
    "toTable": "Dim_Date",
    "toColumn": "日付"
   },
   {
    "name": "r02",
    "fromTable": "Fact_Orders",
    "fromColumn": "顧客ID",
    "toTable": "Dim_Customer",
    "toColumn": "顧客ID"
   },
   {
    "name": "r03",
    "fromTable": "Fact_Orders",
    "fromColumn": "商品ID",
    "toTable": "Dim_Product",
    "toColumn": "商品ID"
   },
   {
    "name": "r04",
    "fromTable": "Fact_Orders",
    "fromColumn": "チャネルID",
    "toTable": "Dim_Channel",
    "toColumn": "チャネルID"
   },
   {
    "name": "r05",
    "fromTable": "Fact_Orders",
    "fromColumn": "キャンペーンID",
    "toTable": "Dim_Campaign",
    "toColumn": "キャンペーンID"
   },
   {
    "name": "r06",
    "fromTable": "Fact_Web",
    "fromColumn": "日付",
    "toTable": "Dim_Date",
    "toColumn": "日付"
   },
   {
    "name": "r07",
    "fromTable": "Fact_Web",
    "fromColumn": "チャネルID",
    "toTable": "Dim_Channel",
    "toColumn": "チャネルID"
   },
   {
    "name": "r08",
    "fromTable": "Fact_Ads",
    "fromColumn": "日付",
    "toTable": "Dim_Date",
    "toColumn": "日付"
   },
   {
    "name": "r09",
    "fromTable": "Fact_Ads",
    "fromColumn": "チャネルID",
    "toTable": "Dim_Channel",
    "toColumn": "チャネルID"
   },
   {
    "name": "r10",
    "fromTable": "Fact_Ads",
    "fromColumn": "キャンペーンID",
    "toTable": "Dim_Campaign",
    "toColumn": "キャンペーンID"
   },
   {
    "name": "r11",
    "fromTable": "Fact_Target",
    "fromColumn": "年月",
    "toTable": "Dim_Date",
    "toColumn": "日付"
   }
  ],
  "annotations": [
   {
    "name": "__PBI_TimeIntelligenceEnabled",
    "value": "0"
   },
   {
    "name": "PBI_QueryOrder",
    "value": "[\"Dim_Date\", \"Dim_Channel\", \"Dim_Campaign\", \"Dim_Product\", \"Dim_Customer\", \"Fact_Orders\", \"Fact_Web\", \"Fact_Ads\", \"Fact_Target\", \"_メジャー\"]"
   }
  ],
  "roles": [
   {
    "name": "関東担当",
    "modelPermission": "read",
    "tablePermissions": [
     {
      "name": "Dim_Customer",
      "filterExpression": "[地域] = \"関東\""
     }
    ]
   }
  ]
 }
}