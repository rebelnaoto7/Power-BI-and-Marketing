        "    変更された型 = Table.TransformColumnTypes(ソース, {{\"商品ID\", type text}, {\"商品名\", type text}, {\"カテゴリ\", type text}, {\"定価\", Int64.Type}, {\"原価\", Int64.Type}, {\"発売日\", type date}})",
